# ============================================================================
# .env.example —— 环境变量**样板**（只放占位符，可以进仓库）
#
# 规矩一句话：**这个文件里永远不许出现真实值。**
#   真实值一旦出现在这里，就等于进了仓库、进了 git 历史，删掉也没用。
#
# 用法：
#   1) cp .env.example .env        ← .env 已被 .gitignore 忽略，真值只写在那里
#   2) node env-to-js.js           ← 生成 js/env.local.js（同样被忽略），页面即可读到
#   3) .env 与 js/env.local.js 永远不要提交
#   4) 提交前跑：node check-secrets.js（会检查本文件里没混进真实值）
#
# 本项目的部署形态：**静态前端 + 托管后端**，没有构建步骤，
# 所以「环境变量」的落点是页面里的 window.__ENV__（见 js/cloud-config.js 顶部注释）。
# ============================================================================


# ---------------------------------------------------------------------------
# 组 A · 前端可见的配置（公开标识，**不是密钥**）
#
# 这两个值必须出现在客户端 —— 浏览器里本来就看得见，藏不住。
# 它们的「无害」不靠口头保证，靠实测（docs/day23-secrets-and-errors.md §1.2）：
#   拿 publishableKey 去读他人线索 / 改热度 / 删条目，返回一律是 401。
# 换句话说：拿到它也只能做「所有人本来就能做的事」。
# ---------------------------------------------------------------------------
WB_SITE_ORIGIN=https://your-app.example.com
WB_ENDPOINT=https://your-app.example.com
WB_PUBLISHABLE_KEY=wbpk_your_key_here


# ---------------------------------------------------------------------------
# 组 B · 只在服务端（**任何一个都不许进前端代码、不许进本仓库**）
#
# 留空是刻意的：这里出现值就意味着已经泄漏了。
# 本项目的这些凭据全部由托管平台持有，前端够不到、也不需要 ——
# 数据库连接串只活在平台的执行通道里，LLM 走平台免密钥通道（没有 API Key 可填）。
# env-to-js.js 会**跳过**这一段：它们不会被写进 js/env.local.js，也就永远到不了浏览器。
# ---------------------------------------------------------------------------
DATABASE_URL=
SERVICE_ROLE_KEY=
LLM_API_KEY=
